# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID: Google OAuth 2.0 Client ID created in Google Cloud Console
# Used for Google Account Login ("Continue with Google")
GOOGLE_CLIENT_ID=

# GOOGLE_CLIENT_SECRET: Google OAuth 2.0 Client Secret from Google Cloud Console
# Kept securely on the backend server for code exchange and token verification
GOOGLE_CLIENT_SECRET=
